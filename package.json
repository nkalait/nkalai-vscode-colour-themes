{
  "name": "nkalai-theme",
  "displayName": "nkalai Theme",
  "description": "Paired light/dark Visual Studio Code themes with a dimmed light variant and a shared #77B58D accent for balanced day/night use.",
  "version": "0.0.4",
  "publisher": "nkalait",
  "license": "MIT",
  "icon": "icon.png",
  "homepage": "https://github.com/nkalait/nkalai-vscode-colour-themes#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/nkalait/nkalai-vscode-colour-themes.git"
  },
  "bugs": {
    "url": "https://github.com/nkalait/nkalai-vscode-colour-themes/issues"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "scripts": {
    "package": "vsce package",
    "publish": "vsce publish"
  },
  "galleryBanner": {
    "color": "#77B58D",
    "theme": "dark"
  },
  "screenshots": [
    {
      "path": "media/preview-light.png"
    },
    {
      "path": "media/preview-dark.png"
    }
  ],
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "dark",
    "light",
    "earthy",
    "nkalai"
  ],
  "contributes": {
    "themes": [
      {
        "label": "nkalai Light",
        "uiTheme": "vs",
        "path": "./themes/nkalai-light-color-theme.json"
